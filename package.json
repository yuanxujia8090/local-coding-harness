{
	"name": "local-model-harness",
	"version": "0.2.0",
	"description": "Thin coding harness for pi + local models: work protocol, provider lock, telemetry, task completion ledger, context watchdog, loop guard.",
	"main": "index.ts",
	"pi": {
		"extensions": [
			"."
		]
	},
	"keywords": [
		"pi-package",
		"pi-coding-agent",
		"local-models",
		"lmstudio",
		"agent-harness"
	],
	"license": "MIT",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"typebox": "^1.3.10"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"files": [
		"index.ts",
		"src/",
		"local-model-harness.example.json",
		"README.md",
		"README.zh-CN.md",
		"LICENSE",
		"package.json"
	]
}
